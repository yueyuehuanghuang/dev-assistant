# 与 DevFlow-AI 的配置项一致，真实配置只保存在 .env 中。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# 公开仓库可留空；如需要，填写具有目标仓库读取权限的 Token。
GITHUB_TOKEN=

# mcp (default): SDK stdio GitHub server; direct: in-process tools for debugging.
TOOL_TRANSPORT=mcp

# Knowledge embeddings: configure your provider's compatible base URL (without /embeddings).
# These credentials are separate from the chat model. No automatic key/model fallback.
EMBEDDING_BASE_URL=http://127.0.0.1:8011/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
# Enable only if your provider supports the dimensions request parameter.
EMBEDDING_SEND_DIMENSIONS=false
# Model-specific threshold; calibrate with retrieval tests, not answer confidence.
EMBEDDING_MIN_SIMILARITY=0.35
EMBEDDING_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Optional localhost model adapter. See KNOWLEDGE.md for reusing the DevFlow model.
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_DEVICE=cpu

# Estimated per-request context budget; includes model tool definitions.
CONTEXT_TOKEN_BUDGET=16000

# Full stack (docker compose sets internal service addresses automatically).
# Leave DATABASE_URL empty only for the SQLite development mode.
DATABASE_URL=postgresql://devassistant:devassistant_local@127.0.0.1:54329/devassistant
VECTOR_BACKEND=milvus
MILVUS_URI=http://127.0.0.1:19539
MILVUS_TOKEN=
AGENT_MODE=multi
